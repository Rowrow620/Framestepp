let mut counter = 0;

fn next() -> Int {
    counter = counter + 1;
    counter
}

fn choose(first: Bool) -> Int {
    if first { return 7; };
    9
}

fn digits(first: Int, second: Int, third: Int) -> Int {
    first * 100 + second * 10 + third
}

print(choose(true));
print(choose(false));
print(next() - next());
print(digits(next(), next(), next()));
print(counter);
